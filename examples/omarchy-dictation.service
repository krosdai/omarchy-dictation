[Unit]
Description=Omarchy dictation xAI adapter
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/omarchy-dictation/dictation.py serve
EnvironmentFile=%h/.config/omarchy-dictation/environment
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=default.target
